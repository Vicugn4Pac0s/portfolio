---
interface HistoryDetailSection {
  heading: string;
  paragraphs: string[];
}

interface Props {
  title: string;
  phase: string;
  text: string;
  detail: HistoryDetailSection[];
}

const { title, phase, text, detail } = Astro.props;
---

<article class="history-item">
  <details class="history-item__details">
    <summary class="history-item__summary" data-cursor-label="VIEW DETAIL">
      <h3 class="history-item__title">{title}</h3>
      <span class="history-item__phase">{phase}</span>
      <span class="history-item__text">{text}</span>
    </summary>
    <div class="history-item__detail">
      {detail.map((section) => (
        <section class="history-item__detail-section">
          <h4 class="history-item__detail-heading">{section.heading}</h4>
          <div class="history-item__detail-body">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))}
    </div>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLElement>('.history-item').forEach((root) => {
    if (root.dataset.cursorLabelInitialized === 'true') {
      return;
    }

    const details = root.querySelector<HTMLDetailsElement>('.history-item__details');
    const summary = root.querySelector<HTMLElement>('.history-item__summary');

    if (!details || !summary) {
      return;
    }

    root.dataset.cursorLabelInitialized = 'true';

    const syncCursorLabel = () => {
      summary.dataset.cursorLabel = details.open ? '' : 'VIEW DETAIL';
    };

    syncCursorLabel();
    details.addEventListener('toggle', syncCursorLabel);
  });
</script>

<style lang="scss">
  @use '@styles/global' as *;

  .history-item {
    position: relative;

    &::before {
      position: absolute;
      top: 4px;
      left: -52px;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--color-primary);
      content: "";

      @include media-sp {
        left: -36px;
      }
    }

    &__details {
      margin: 0;
      padding: 0;
    }

    &__summary {
      appearance: none;
      margin: 0;
      padding: 0;
      cursor: pointer;
      list-style: none;
      list-style-type: none;

      &::marker,
      &::-webkit-details-marker {
        display: none;
        content: "";
      }
    }

    &__title {
      margin: 0 0 8px;
      font-size: 16px;
      font-weight: 800;
    }

    &__phase {
      display: block;
      margin: 0 0 8px;
      color: var(--color-ink);
      font-size: 14px;
      font-weight: 800;
    }

    &__text {
      display: block;
      margin: 0;
      color: var(--color-muted);
      font-size: 12px;
      font-weight: 650;
      line-height: 2;
    }
    &__detail {
      display: grid;
      gap: 24px;
      padding: 24px 12px 0;
    }

    &__detail-section {
      display: grid;
      gap: 8px;
    }

    &__detail-heading {
      margin: 0;
      color: var(--color-ink);
      font-size: 14px;
      font-weight: 800;
    }

    &__detail-body {
      display: grid;
      gap: 8px;
      color: var(--color-muted);
      font-size: 12px;
      line-height: 2;

      p {
        margin: 0;
      }
    }
  }
</style>
