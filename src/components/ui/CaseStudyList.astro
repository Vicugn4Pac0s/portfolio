---
import CaseStudyCard from './CaseStudyCard.astro';
import type { CaseStudySummary } from '../../data/caseStudies';

interface Props {
  studies: CaseStudySummary[];
  headingLevel?: 'h2' | 'h3';
  maxItems?: number;
}

const { studies, headingLevel = 'h2', maxItems } = Astro.props;
const displayedStudies = maxItems === undefined
  ? studies
  : studies.slice(0, Math.max(0, Math.floor(maxItems)));
---

<ul class="case-study-list">
  {displayedStudies.map((study) => (
    <li class="case-study-list__item">
      <CaseStudyCard
        slug={study.slug}
        title={study.title}
        description={study.description}
        category={study.category}
        image={study.image}
        headingLevel={headingLevel}
      />
    </li>
  ))}
</ul>

<style lang="scss">
  @use '@styles/global' as *;

  .case-study-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;

    @include media-tab {
      grid-template-columns: repeat(2, 1fr);
    }

    @include media-sp {
      grid-template-columns: 1fr;
    }

    &__item {
      height: 100%;
    }
  }
</style>
