---
import { Icon } from 'astro-icon/components';
---

<footer class="site-footer">
  <div class="site-footer__inner site-container">
    <a class="site-footer__logo" href="/">
      yoshiki.<span class="site-footer__logo-accent">rundev</span>
    </a>
    <p class="site-footer__copy">&copy; 2026 yoshiki.rundev All rights reserved.</p>
    <a class="site-footer__back-top" href="#" aria-label="Back to top">
      <Icon name="lucide:chevron-up" aria-hidden="true" />
    </a>
  </div>
</footer>

<style lang="scss">
  @use '@styles/global' as *;

  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-line) 80%, transparent);
    padding-block: 36px;

    &__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--color-muted);
      font-size: 12px;
      font-weight: 650;

      @include media-sp {
        align-items: flex-start;
        flex-direction: column;
        gap: 24px;
      }
    }

    &__logo {
      color: var(--color-ink);
      font-size: 16px;
      font-weight: 650;
    }

    &__logo-accent {
      color: var(--color-primary);
    }

    &__copy {
      margin: 0;
    }

    &__back-top {
      display: grid;
      width: 48px;
      height: 48px;
      border: 1px solid var(--color-line);
      border-radius: 999px;
      color: var(--color-ink);
      font-size: 20px;
      place-items: center;
      transition: var(--delay-in);

      &:hover {
        background-color: var(--color-accent);
      }
    }
  }
</style>
